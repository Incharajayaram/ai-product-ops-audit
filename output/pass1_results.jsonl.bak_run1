{"app_id": 16, "name": "LiveAgent", "category": "Support and Helpdesk", "one_line_description": "LiveAgent is a help desk software that provides ticketing, live chat, and knowledge base functionalities.", "auth_methods": ["API key", "OAuth2"], "self_serve_status": "self_serve_trial", "gating_detail": "Developers can register for a 30-day free trial without a credit card to gain access to the API and generate API keys.", "api_surface_summary": "LiveAgent offers a REST API (v1 and v3) that allows interaction with core helpdesk objects like agents and tickets, supporting CRUD operations. The API is well-documented within the LiveAgent account, includes examples, and provides a Swagger (OpenAPI) descriptor for generating SDKs.", "has_existing_mcp": true, "mcp_detail": "LiveAgent provides an MCP server that offers a standardized, permission-scoped way for AI clients like Claude Desktop to search, tag, and act on tickets.", "buildability_verdict": "ready_today", "main_blocker": null, "evidence_urls": ["https://support.liveagent.com/567924-Documentation", "https://support.liveagent.com/802463-REST-API", "https://www.liveagent.com/pricing", "https://www.liveagent.com/features/api", "https://support.liveagent.com/911737-API-v3", "https://support.liveagent.com/741982-API-key", "https://www.liveagent.com/trial/"], "confidence": 0.95, "notes": null, "_meta": {"status": "ok", "seconds": 15.4, "evidence_urls_gathered": ["https://support.liveagent.com/567924-Documentation", "https://support.liveagent.com/802463-REST-API", "https://support.liveagent.com/347389-Single-sign-on-generic-example", "https://www.liveagent.com/pricing", "https://www.liveagent.com/features/api", "https://support.liveagent.com/911737-API-v3"]}}
