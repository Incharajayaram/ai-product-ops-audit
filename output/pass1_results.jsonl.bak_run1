{"app_id": 7, "name": "Zoho CRM", "category": "CRM and Sales", "one_line_description": "Zoho CRM is a customer relationship management system that allows access to resources such as Leads, Contacts, and Deals via its API.", "auth_methods": ["OAuth2"], "self_serve_status": "self_serve_free", "gating_detail": "Developers can register their application through the developer console of their Zoho account to obtain a client ID and client secret, and new users can sign up for free to access the MCP playground.", "api_surface_summary": "The Zoho CRM API is a RESTful API, indicated by its use of OpenAPI definitions for various resources like bulk write, business hours, and webhooks, suggesting a broad and well-documented surface.", "has_existing_mcp": true, "mcp_detail": "Zoho MCP (Model Context Protocol) is an official initiative by Zoho designed to empower AI agents by transforming business apps into intelligent, agent-ready systems, with a free sign-up and playground available.", "buildability_verdict": "ready_today", "main_blocker": null, "evidence_urls": ["https://www.zoho.com/crm/developer/docs/api/v8/oauth-overview.html", "https://www.zoho.com/crm/developer/docs/api/v8/auth-request.html", "https://www.zoho.com/assist/api/authentication.html", "https://www.zoho.com/mcp", "https://apis.io/security/zoho-crm/zoho-crm-authentication"], "confidence": 1.0, "notes": null, "_meta": {"status": "ok", "seconds": 40.1, "evidence_urls_gathered": ["https://www.zoho.com/crm/developer/docs/api/v8/oauth-overview.html", "https://www.zoho.com/crm/developer/docs/api/v8/auth-request.html", "https://www.zoho.com/assist/api/authentication.html", "https://www.zoho.com/mcp", "https://zoho-crm-api.readthedocs.io/en/latest/authentication", "https://apis.io/security/zoho-crm/zoho-crm-authentication"]}}
