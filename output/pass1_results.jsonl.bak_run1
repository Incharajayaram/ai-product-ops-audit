{"app_id": 19, "name": "Gorgias", "category": "Support and Helpdesk", "one_line_description": "Gorgias is a helpdesk program that allows programmatic reading and writing of data to manage customer support interactions.", "auth_methods": ["API key", "Basic", "OAuth2"], "self_serve_status": "gated_paid_plan", "gating_detail": "API credentials, including API keys, are available to account owners and admins on all Gorgias Helpdesk plans, which implies a paid plan is required. For OAuth2, creating an app on a partners' account and approval are required.", "api_surface_summary": "Gorgias offers a REST API for reading and writing helpdesk data, which is well-documented with a dedicated developer documentation portal and a Postman collection. It supports cursor-based pagination, webhooks, and has defined rate limits.", "has_existing_mcp": true, "mcp_detail": "An official Gorgias MCP (Model Connector Protocol) server exists and is available in Claude's connector directory and ChatGPT's plugin directory. For other AI clients, it can be added as an HTTP MCP server.", "buildability_verdict": "ready_today", "main_blocker": null, "evidence_urls": ["https://docs.gorgias.com/en-US/rest-api-208286", "https://developers.gorgias.com/docs/oauth2-authentication-for-creating-apps-with-gorgias", "https://www.gorgias.com/llm-info", "https://www.getmacha.com/blog/how-to-use-the-gorgias-api"], "confidence": 1.0, "notes": null, "_meta": {"status": "ok", "seconds": 18.0, "evidence_urls_gathered": ["https://docs.gorgias.com/en-US/rest-api-208286", "https://developers.gorgias.com/docs/oauth2-authentication-for-creating-apps-with-gorgias", "https://www.gorgias.com/llm-info", "https://docs.digitalgenius.com/docs/gorgias-get-credentials", "https://www.getmacha.com/blog/how-to-use-the-gorgias-api", "https://help.alchemer.com/help/gorgias-authentication"]}}
